#!/bin/sh
# Resolve the installed command symlink without relying on the caller's cwd.
# No shell config changes, builds or provider calls happen during resolution.
launcher=$0
if [ "${launcher#*/}" = "$launcher" ]; then
    launcher=$(command -v "$launcher") || exit 1
fi
while [ -L "$launcher" ]; do
    target=$(readlink "$launcher") || exit 1
    case "$target" in
        /*) launcher=$target ;;
        *) launcher=$(dirname -- "$launcher")/$target ;;
    esac
done
root=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd) || exit 1
if [ "${1:-}" = session ]; then
    shift
    exec python3 "$root/src/session_host.py" "$@"
fi
if [ "${1:-}" = tui ]; then
    shift
    exec "$root/.build/tui" --session-host "$root/src/session_host.py" --update-payload "$root/.build/payload" --update-checksum "$root/.build/cli_view.sha256" "$@"
fi
if [ "$#" -eq 0 ]; then
    exec "$root/.build/tui" --session-host "$root/src/session_host.py" --update-payload "$root/.build/payload" --update-checksum "$root/.build/cli_view.sha256"
fi
exec python3 "$root/src/cli.py" "$@"
